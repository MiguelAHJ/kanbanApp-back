# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube a git (ver .gitignore).

# --- Base de datos (Postgres local; en el servidor de la empresa solo cambia el HOST) ---
POSTGRES_USER=issueflow
POSTGRES_PASSWORD=issueflow_dev
POSTGRES_DB=issueflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- GitLab ---
GITLAB_URL=https://gitlab.tuempresa.com
GITLAB_TOKEN=

# --- Motor de IA para lectura de fotos y armado de minuta ---
# "local" usa Ollama (gratis, privado, corre en tu maquina)
# "gemini" usa la API de Gemini (free tier, mejor precision con letra manuscrita)
AI_PROVIDER=local

# Solo si AI_PROVIDER=gemini
GEMINI_API_KEY=

# Solo si AI_PROVIDER=local (Ollama debe estar corriendo: `ollama serve`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TEXT_MODEL=llama3.1

# --- Transcripcion ---
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=es
